<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/link_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/logo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/f2s"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Android link (shown only if provided) -->
        <TextView
            android:id="@+id/androidLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open in Play Store"
            android:textColor="#1B73E8"
            android:textStyle="bold"
            android:paddingVertical="6dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- iOS link (shown only if provided) -->
        <TextView
            android:id="@+id/iosLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open in App Store"
            android:textColor="#1B73E8"
            android:textStyle="bold"
            android:paddingVertical="6dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>
